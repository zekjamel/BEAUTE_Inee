{% extends 'password_reset/base.html.twig' %}

{% block title %}E-mail envoyé | Beaute INEE{% endblock %}

{% block body %}
    <main class="account-page-wrap">
        <p class="section-id">Mot de passe oublié</p>
        <h1>Vérifiez votre boîte de réception</h1>
        <div class="account-card">
            <p>Si un compte correspond à cette adresse, un e-mail contenant un lien de réinitialisation vient d'être envoyé. Ce lien est valable 1 heure.</p>
            <p>Pensez à vérifier vos courriers indésirables.</p>
        </div>
        <a class="account-link" href="{{ path('app_login') }}">Retour à la connexion</a>
    </main>
{% endblock %}
