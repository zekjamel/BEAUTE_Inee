{% extends 'password_reset/base.html.twig' %}

{% block title %}Mot de passe oublié | Beaute INEE{% endblock %}

{% block body %}
    <main class="account-page-wrap">
        <p class="section-id">Mot de passe oublié</p>
        <h1>Réinitialiser votre mot de passe</h1>
        <p>Indiquez l'adresse e-mail de votre compte. Si elle est enregistrée, vous recevrez un lien pour choisir un nouveau mot de passe.</p>

        <form class="account-card" method="post">
            {% if error %}
                <p class="account-error">{{ error }}</p>
            {% endif %}
            <input type="hidden" name="_token" value="{{ csrf_token('password_reset_request') }}">
            <div class="account-field">
                <label for="email">Email</label>
                <input id="email" name="email" type="email" required autocomplete="email">
            </div>
            <button class="account-button" type="submit">Envoyer le lien</button>
        </form>

        <a class="account-link" href="{{ path('app_login') }}">Retour à la connexion</a>
    </main>
{% endblock %}
