{% extends 'base.html.twig' %}

{% block title %}Connexion | Beaute INEE{% endblock %}
{% block body_class %}customers bg--white account-page{% endblock %}

{% block stylesheets %}
    <style>
        .account-page-wrap { max-width: 620px; margin: 140px auto 70px; padding: 0 24px; font-family: Lato, sans-serif; color: #353535; }
        .account-card { border: 1px solid #e6ded9; padding: 32px; background: #fff; }
        .account-field { display: grid; gap: 8px; margin-bottom: 18px; }
        .account-field label { font-weight: 700; }
        .account-field input { min-height: 48px; border: 1px solid #ddd; padding: 0 14px; font: inherit; }
        .account-button { border: 0; background: #c65a35; color: #fff; padding: 15px 24px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; cursor: pointer; }
        .account-button:disabled { cursor: wait; opacity: .65; }
        .account-error { color: #a53b24; font-weight: 700; }
        .account-separator { display: flex; align-items: center; gap: 14px; margin: 28px 0; color: #888; font-size: 12px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
        .account-separator::before, .account-separator::after { content: ''; flex: 1; height: 1px; background: #e6ded9; }
        .card-login-intro { margin-top: 0; line-height: 1.6; color: #666; }
        .card-login-result { display: none; margin: 16px 0 0; padding: 12px 14px; background: #f5f1ee; line-height: 1.5; }
        .card-login-result.is-visible { display: block; }
        .card-login-result.is-waiting { background: #f5f1ee; color: #4f4f4f; }
        .card-login-result.is-error { background: #fff0eb; color: #8b321e; }
        .card-login-help { display: block; margin-top: 8px; font-size: 14px; color: #777; }
    </style>
{% endblock %}

{% block body %}
    <main class="account-page-wrap">
        <p class="section-id">Compte client</p>
        <h1>Connexion</h1>

        <form class="account-card" method="post">
            {% if error %}
                <p class="account-error">Identifiants invalides ou compte non active.</p>
            {% endif %}
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <div class="account-field">
                <label for="username">Email</label>
                <input id="username" name="_username" type="email" value="{{ lastUsername }}" required autocomplete="email">
            </div>
            <div class="account-field">
                <label for="password">Mot de passe</label>
                <input id="password" name="_password" type="password" required autocomplete="current-password">
            </div>
            <button class="account-button" type="submit">Se connecter</button>
        </form>

        <div class="account-separator">ou</div>

        <section class="account-card" aria-labelledby="card-login-title">
            <h2 id="card-login-title">Connexion avec ma carte</h2>
            <p class="card-login-intro">Sur mobile, approchez votre carte Beauté INÉE du téléphone lorsque celui-ci vous le demande. Sur ordinateur, insérez-la dans votre lecteur compatible. Confirmez ensuite avec votre empreinte.</p>
            <button
                id="card-login-button"
                class="account-button"
                type="button"
                data-initialize-url="{{ path('account_card_login_initialize') }}"
                data-client-url="{{ path('account_card_login_client_api', {operation: 'OPERATION'}) }}"
                data-verify-url="{{ path('account_card_login_verify') }}"
                data-csrf="{{ csrf_token('card_login') }}"
            >Se connecter avec la carte</button>
            <p id="card-login-result" class="card-login-result" role="status" aria-live="polite"></p>
        </section>
    </main>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        (() => {
            const button = document.getElementById('card-login-button');
            const result = document.getElementById('card-login-result');
            if (!button || !result) return;

            const show = (message, state = 'waiting', help = '') => {
                result.textContent = message;
                if (help !== '') {
                    const helpElement = document.createElement('span');
                    helpElement.className = 'card-login-help';
                    helpElement.textContent = help;
                    result.appendChild(helpElement);
                }
                result.className = `card-login-result is-visible is-${state}`;
            };
            const toBase64 = (buffer) => {
                let binary = '';
                new Uint8Array(buffer).forEach((byte) => { binary += String.fromCharCode(byte); });
                return btoa(binary);
            };
            const clientUrl = (operation) => button.dataset.clientUrl.replace('OPERATION', operation);
            const responseError = async (response) => {
                const content = await response.text().catch(() => '');
                let payload = null;
                try { payload = JSON.parse(content); } catch (error) {}
                return payload?.message || content || 'La connexion par carte a échoué.';
            };

            button.addEventListener('click', async () => {
                if (!window.PublicKeyCredential || !navigator.credentials?.get) {
                    show('Ce navigateur ne prend pas en charge la connexion sécurisée par carte.', 'error');
                    return;
                }

                button.disabled = true;
                show('Préparation de la connexion sécurisée…');
                let requestStartedAt = null;

                try {
                    const initialize = await fetch(button.dataset.initializeUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': button.dataset.csrf },
                        credentials: 'same-origin',
                        body: '{}',
                    });
                    if (!initialize.ok) throw new Error(await responseError(initialize));
                    const handle = (await initialize.json()).handle;
                    const headers = { 'ClientApiToken': handle, 'Accept': 'application/json' };

                    const challengeResponse = await fetch(clientUrl('GetChallenge'), { headers, credentials: 'same-origin' });
                    if (!challengeResponse.ok) throw new Error(await responseError(challengeResponse));
                    const challenge = await challengeResponse.arrayBuffer();

                    show(
                        'En attente de la carte…',
                        'waiting',
                        'Sur mobile, gardez la carte immobile au dos du téléphone quand Android affiche la demande de clé de sécurité. Sur ordinateur, insérez la carte dans le lecteur puis posez votre doigt.'
                    );
                    requestStartedAt = Date.now();
                    const credential = await navigator.credentials.get({
                        publicKey: {
                            challenge: new Uint8Array(challenge),
                            rpId: window.location.hostname,
                            allowCredentials: [],
                            userVerification: 'required',
                            timeout: 300000,
                            hints: ['security-key'],
                        },
                    });
                    if (!credential) throw new Error('La carte n’a pas répondu.');

                    const verification = await fetch(button.dataset.verifyUrl, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-CSRF-Token': button.dataset.csrf,
                            'ClientApiToken': handle,
                        },
                        credentials: 'same-origin',
                        body: JSON.stringify({
                            Id: credential.id,
                            Type: credential.type,
                            ClientDataBase64Encoded: toBase64(credential.response.clientDataJSON),
                            AuthenticatorData64Encoded: toBase64(credential.response.authenticatorData),
                            Signature: toBase64(credential.response.signature),
                            UserHandle: credential.response.userHandle ? toBase64(credential.response.userHandle) : '',
                        }),
                    });
                    const verificationPayload = await verification.json().catch(() => null);
                    if (!verification.ok || !verificationPayload?.success) {
                        throw new Error(verificationPayload?.message || 'La carte n’a pas confirmé votre identité.');
                    }

                    show('Identité confirmée. Ouverture de votre espace…');
                    window.location.assign(verificationPayload.redirectUrl);
                } catch (error) {
                    const elapsedMs = typeof requestStartedAt === 'number' ? Date.now() - requestStartedAt : null;
                    const isMobile = /Android|iPhone|iPad|iPod/i.test(window.navigator.userAgent);
                    const rejectedImmediately = elapsedMs !== null && elapsedMs < 2000;

                    console.warn('Card login WebAuthn failed', {
                        name: error?.name,
                        message: error?.message,
                        elapsedMs,
                        userAgent: window.navigator.userAgent,
                    });

                    let message = error?.message || 'La connexion par carte a échoué.';
                    if (error?.name === 'NotAllowedError' && isMobile && rejectedImmediately) {
                        message = 'Le téléphone n’a pas ouvert l’écoute NFC de la carte. Ouvrez cette page dans Chrome, vérifiez que le NFC est activé, puis réessayez.';
                    } else if (error?.name === 'NotAllowedError') {
                        message = 'La carte n’a pas répondu. Gardez-la immobile au dos du téléphone ou dans le lecteur, puis réessayez avec votre empreinte.';
                    }

                    show(message, 'error');
                } finally {
                    button.disabled = false;
                }
            });
        })();
    </script>
{% endblock %}
