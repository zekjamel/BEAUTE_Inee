{% set is_en = locale == 'en' %}
<!doctype html>
<html lang="{{ locale }}">
<head>
    <meta charset="utf-8">
    <title>{{ is_en ? 'Reset your password' : 'Réinitialisez votre mot de passe' }}</title>
</head>
<body style="margin:0;padding:0;background:#f6f2ef;font-family:Arial,sans-serif;color:#333;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f6f2ef;padding:32px 12px;">
        <tr>
            <td align="center">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:620px;background:#ffffff;border:1px solid #eaded8;">
                    <tr>
                        <td style="padding:34px 34px 10px;text-align:center;">
                            <div style="font-size:18px;letter-spacing:5px;font-weight:700;text-transform:uppercase;">Beauté INÉE</div>
                            <div style="font-size:11px;letter-spacing:3px;text-transform:uppercase;color:#777;margin-top:4px;">Paris</div>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:20px 34px 34px;">
                            <p style="margin:0 0 12px;font-size:15px;color:#777;">
                                {{ is_en ? 'Hello' : 'Bonjour' }} {{ customer ? customer.firstName : '' }},
                            </p>
                            <h1 style="margin:0 0 16px;font-size:30px;line-height:1.15;color:#333;">
                                {{ is_en ? 'Choose a new password.' : 'Choisissez un nouveau mot de passe.' }}
                            </h1>
                            <p style="margin:0 0 24px;font-size:16px;line-height:1.7;color:#666;">
                                {{ is_en
                                    ? 'A password reset was requested for your Beaute INEE account. Click the button below to choose a new one.'
                                    : 'Une réinitialisation du mot de passe de votre compte Beauté INÉE a été demandée. Cliquez sur le bouton ci-dessous pour en choisir un nouveau.'
                                }}
                            </p>
                            <p style="margin:0 0 28px;text-align:center;">
                                <a href="{{ resetUrl }}" style="display:inline-block;background:#c85d38;color:#ffffff;text-decoration:none;text-transform:uppercase;letter-spacing:2px;font-size:13px;font-weight:700;padding:16px 26px;">
                                    {{ is_en ? 'Reset my password' : 'Réinitialiser mon mot de passe' }}
                                </a>
                            </p>
                            <p style="margin:0;font-size:13px;line-height:1.6;color:#888;">
                                {{ is_en
                                    ? 'This link is valid for 1 hour. If you did not request it, you can ignore this email: your password will not change.'
                                    : 'Ce lien est valable 1 heure. Si vous n’êtes pas à l’origine de cette demande, ignorez cet e-mail : votre mot de passe ne sera pas modifié.'
                                }}
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
