{% extends 'admin/base.html.twig' %}
{% block title %}{{ product.id ? 'Modifier' : 'Ajouter' }} une offre | Beauté INÉE{% endblock %}
{% block admin_stylesheets %}<style>
.catalog-form { max-width:960px; }.catalog-fields { display:grid;grid-template-columns:1fr 1fr;gap:20px;padding:24px; }.catalog-field { display:grid;gap:8px;align-content:start;min-width:0; }.catalog-field input,.catalog-field select,.catalog-field textarea { width:100%;padding:12px;border:1px solid #ccc;border-radius:4px;font:inherit; }.catalog-field textarea { min-height:110px; }.catalog-wide { grid-column:1/-1; }.catalog-form fieldset { margin:24px 0;padding:24px;border:1px solid #e6ded9; }.catalog-form legend { float:none;width:auto;padding:0 8px;font-size:20px; }.catalog-help { color:#666;line-height:1.6; }.catalog-submit { padding:14px 24px;border:0;background:#c65a35;color:white;cursor:pointer; }@media(max-width:700px){.catalog-fields { grid-template-columns:1fr;padding:16px; }}
</style>{% endblock %}
{% block admin_content %}
<a href="{{ path('admin_product_index') }}">← Produits et livraison</a>
<header class="admin-page-header"><div><h1>{{ product.id ? 'Modifier' : 'Ajouter' }} une offre</h1><p class="admin-page-subtitle">Les changements s’appliquent aux prochains achats. Les commandes déjà créées restent inchangées.</p></div></header>
{% if error %}<p role="alert" class="admin-flash admin-flash--error">{{ error }}</p>{% endif %}
<form method="post" class="catalog-form">
<input type="hidden" name="_token" value="{{ csrf_token('product_' ~ (product.id ?? 'new')) }}">
<section class="admin-panel catalog-fields">
<div class="catalog-field"><label for="name">Nom de l’offre</label><input id="name" name="name" value="{{ values.name|default('') }}" maxlength="180" required></div>
<div class="catalog-field"><label for="sku">Référence unique</label><input id="sku" name="sku" value="{{ values.sku|default('') }}" maxlength="100" pattern="[A-Za-z0-9_\-]+" required></div>
<div class="catalog-field"><label for="type">Type</label><select id="type" name="type">{% for key, label in types %}<option value="{{ key }}" {{ values.type|default('card') == key ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></div>
<div class="catalog-field"><label for="price">Prix de vente (€)</label><input id="price" name="price" inputmode="decimal" value="{{ values.price|default('') }}" required><small>Hors frais de remise. Deux décimales maximum.</small></div>
<div class="catalog-field"><label for="diagnosticCount">Nombre de diagnostics inclus</label><input type="number" id="diagnosticCount" name="diagnosticCount" min="0" max="100" value="{{ values.diagnosticCount|default(0) }}" required></div>
<div class="catalog-field catalog-wide"><label for="description">Description et contenu de l’offre</label><textarea id="description" name="description" maxlength="4000">{{ values.description|default('') }}</textarea></div>
</section>
{% for mode, label in deliveryLabels %}
<fieldset><legend>{{ label }}</legend>
<label><input type="checkbox" name="{{ mode }}Enabled" value="1" {{ values[mode ~ 'Enabled']|default('') == '1' ? 'checked' : '' }}> Proposer ce mode pour cette offre</label>
<div class="catalog-fields">
<div class="catalog-field"><label for="{{ mode }}Price">Frais (€)</label><input id="{{ mode }}Price" name="{{ mode }}Price" inputmode="decimal" value="{{ values[mode ~ 'Price']|default('0.00') }}"><small>0 pour une remise gratuite.</small></div>
{% if mode == 'shipping' %}<div class="catalog-field"><label for="shippingCountries">Pays desservis</label><input id="shippingCountries" name="shippingCountries" value="{{ values.shippingCountries|default('FR, BE, CH') }}"><small>Codes pays séparés par des virgules. Même tarif pour les pays de cette offre.</small></div>{% endif %}
<div class="catalog-field catalog-wide"><label for="{{ mode }}Terms">{{ mode == 'shipping' ? 'Délais et conditions de livraison' : 'Adresse de la boutique et consignes de retrait' }}</label><textarea id="{{ mode }}Terms" name="{{ mode }}Terms" maxlength="2000">{{ values[mode ~ 'Terms']|default('') }}</textarea><small>Obligatoire si ce mode est proposé. Visible avant le paiement et dans la confirmation.</small></div>
</div></fieldset>
{% endfor %}
<p class="catalog-help">Pour une carte, précisez les modalités d’activation en boutique dans la description. Les diagnostics inclus sont indiqués à l’équipe sur la commande ; leur réalisation est organisée séparément.</p>
<p><label><input type="checkbox" name="isActive" value="1" {{ values.isActive|default('') == '1' ? 'checked' : '' }}> Publier cette offre dans le catalogue d’achat</label></p>
<button type="submit" class="catalog-submit">Enregistrer l’offre</button>
</form>
{% endblock %}
